{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": {
      "script": "bash scripts/fix-macos-dylibs.sh",
      "cwd": "src-tauri"
    }
  },
  "bundle": {
    "macOS": {
      "frameworks": [
        "./external-libs/libpq.5.dylib",
        "./external-libs/libssl.3.dylib",
        "./external-libs/libcrypto.3.dylib"
      ]
    }
  }
}
